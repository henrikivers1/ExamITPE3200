@model GalacticSlicer.Models.Character?
@using GalacticSlicer.Helpers

@* Space badge for a character, used in the Shop, the navbar and the Progress page.
   The outer shape shows the tier, the emblem in the middle shows the character.
   With no character (nothing equipped) it draws an empty circle instead.
   The size comes from the element around it (styles in site.css under "Character badge"). *@
@if (Model == null)
{
    <svg class="gs-badge gs-badge--empty" viewBox="0 0 100 100" aria-hidden="true">
        <circle class="gs-badge-slot" cx="50" cy="50" r="40" />
    </svg>
    return;
}

@{
    var tier = CharacterTier.Get(Model.Price).Key;
}

<svg class="gs-badge gs-badge--@tier" viewBox="0 0 100 100" aria-hidden="true">
    @* ribbon tails hanging behind the epic and legendary badges *@
    @if (tier == "epic" || tier == "legendary")
    {
        <path class="gs-badge-ribbon" d="M30 62 L20 96 L32 90 L40 99 L46 70 Z" />
        <path class="gs-badge-ribbon" d="M70 62 L80 96 L68 90 L60 99 L54 70 Z" />
    }

    @* outer shape and inner ring, one pair per tier *@
    @switch (tier)
    {
        case "starter":
            <circle class="gs-badge-base" cx="50" cy="50" r="40" />
            <circle class="gs-badge-ring" cx="50" cy="50" r="31" />
            break;
        case "uncommon":
            <polygon class="gs-badge-base" points="50,8 86,29 86,71 50,92 14,71 14,29" />
            <polygon class="gs-badge-ring" points="50,18 77,34 77,66 50,82 23,66 23,34" />
            break;
        case "rare":
            <path class="gs-badge-base" d="M50 7 L85 19 V47 C85 70 69 85 50 93 C31 85 15 70 15 47 V19 Z" />
            <path class="gs-badge-ring" d="M50 16 L76 25 V47 C76 64 64 76 50 83 C36 76 24 64 24 47 V25 Z" />
            break;
        case "epic":
            <polygon class="gs-badge-base" points="34,10 66,10 89,33 89,63 66,86 34,86 11,63 11,33" />
            <polygon class="gs-badge-ring" points="38,19 62,19 80,37 80,59 62,77 38,77 20,59 20,37" />
            break;
        default:
            <polygon class="gs-badge-base" points="@CharacterTier.StarburstPoints()" />
            <circle class="gs-badge-ring" cx="50" cy="50" r="29" />
            break;
    }

    @* emblem for the character, drawn on a 24x24 grid and scaled into the middle *@
    <g class="gs-badge-icon" transform="translate(32 31) scale(1.5)">
        @switch (Model.Name)
        {
            case "Rookie Slicer":
                @* terminal prompt *@
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M7 10l3 2-3 2M12.5 15h4.5" />
                break;
            case "Astromech Hacker":
                @* astromech droid: dome, body and legs *@
                <path d="M6.5 11a5.5 5.5 0 0 1 11 0" />
                <rect x="6.5" y="11" width="11" height="8" rx="1" />
                <circle cx="12" cy="8.5" r="1.2" />
                <path d="M6.5 19l-2 2.5M17.5 19l2 2.5M10 14.5h4" />
                break;
            case "Smuggler":
                @* light freighter seen from above *@
                <circle cx="11" cy="12" r="6" />
                <path d="M15 8.5l6-1.5v3l-4 1M15 15.5l6 1.5v-3l-4-1" />
                <circle cx="11" cy="12" r="1.5" />
                break;
            case "Bounty Hunter":
                @* targeting crosshair *@
                <circle cx="12" cy="12" r="7" />
                <circle cx="12" cy="12" r="1.5" />
                <path d="M12 2.5v5M12 16.5v5M2.5 12h5M16.5 12h5" />
                break;
            case "Shadow Operative":
                @* watchful eye *@
                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                <circle cx="12" cy="12" r="2.6" />
                break;
            default:
                @* any new character without its own emblem gets a star *@
                <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9Z" />
                break;
        }
    </g>
</svg>
