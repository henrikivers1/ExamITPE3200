@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

@* Friendly page for unexpected server errors (Program.cs: UseExceptionHandler("/Home/Error")).
   The details are in the log file, never shown to the player. *@
<section class="gs-page-intro text-center">
    <h1>Houston, we have a problem</h1>
    <p>Something went wrong on our side. Your progress is safe, please try again in a moment.</p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to base</a>

    @* Only shown when we have an id, so the player can report it and we can find it in the log *@
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small mt-3">Error reference: <code>@Model.RequestId</code></p>
    }
</section>
