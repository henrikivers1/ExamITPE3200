<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Galactic Slicer</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GalacticSlicer.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <header class="gs-header">
        <nav class="gs-navbar">
            <a class="gs-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="gs-brand-icon" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                        <circle cx="12" cy="12" r="5.2" />
                        <ellipse cx="12" cy="12" rx="10.4" ry="3.4" transform="rotate(-24 12 12)" />
                    </svg>
                </span>
                <span>Galactic Slicer</span>
            </a>

            <button class="gs-nav-toggle" type="button" data-gs-nav-toggle aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </button>

            <div class="gs-nav-collapse" id="primaryNav">
                <ul class="gs-nav-links">
                    <li>
                        <a class="gs-nav-link @(activeController == "Home" ? "is-active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li>
                        <a class="gs-nav-link @(activeController == "Planet" ? "is-active" : "")"
                           asp-area="" asp-controller="Planet" asp-action="Index">Galaxy</a>
                    </li>
                    <li>
                        <a class="gs-nav-link @(activeController == "Challenge" ? "is-active" : "")"
                           asp-area="" asp-controller="Challenge" asp-action="Topics">Challenges</a>
                    </li>
                    <li>
                        <a class="gs-nav-link @(activeController == "Progress" ? "is-active" : "")"
                           asp-area="" asp-controller="Progress" asp-action="Index">Progress</a>
                    </li>
                </ul>
                <div class="gs-nav-auth">
                    <a class="gs-btn gs-btn--ghost" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="gs-btn gs-btn--primary gs-btn--sm" asp-area="" asp-controller="Account" asp-action="SignUp">Sign up</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="gs-main">
        @RenderBody()
    </main>

    <footer class="gs-footer">
        <div class="gs-footer-inner">
            <div class="gs-footer-brand">
                <span class="gs-footer-title">Galactic Slicer</span>
                <span>Learn. Practice. A safer galaxy.</span>
            </div>
            <div class="gs-footer-links">
                <a href="#">About</a>
                <a href="#">Contact</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toggle = document.querySelector("[data-gs-nav-toggle]");
            var collapse = document.getElementById("primaryNav");
            if (toggle && collapse) {
                toggle.addEventListener("click", function () {
                    var isOpen = collapse.classList.toggle("is-open");
                    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>