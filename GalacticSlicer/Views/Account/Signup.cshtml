@model GalacticSlicer.ViewModels.SignUpViewModel

@{
    ViewData["Title"] = "Sign up";
}

<section class="gs-auth-wrapper">
    <div class="gs-auth-card">
        <h1 class="gs-auth-title">Sign up</h1>
        <p class="gs-auth-subtitle">Join the fight for a safer galaxy.</p>

        <form asp-action="SignUp" method="post" class="gs-form">
            @* Shows Identity errors like "Username is already taken" or password rules *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="gs-form-group">
                <label class="gs-label" asp-for="Username"></label>
                <input class="gs-input" asp-for="Username" placeholder="Choose a username" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="gs-form-group">
                <label class="gs-label" asp-for="Password"></label>
                <input class="gs-input" asp-for="Password" placeholder="Choose a password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="gs-form-group">
                <label class="gs-label" asp-for="ConfirmPassword"></label>
                <input class="gs-input" asp-for="ConfirmPassword" placeholder="Repeat your password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="gs-btn gs-btn--primary gs-btn--lg gs-form-submit">Sign up</button>
        </form>

        <p class="gs-form-footer">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Log in</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
