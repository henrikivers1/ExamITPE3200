@model int
@{
    ViewData["Title"] = $"Error {Model}";
}

@* Friendly page for 404, 400, 403 ... (Program.cs: UseStatusCodePagesWithReExecute)
   The switch expression picks a message for the status code (conditional rendering). *@
@{
    var message = Model switch
    {
        404 => "This part of the galaxy doesn't exist. The page or item you're looking for was not found.",
        400 => "That request didn't make sense to our systems. Please check what you entered and try again.",
        403 => "You don't have clearance for this sector.",
        _ => "Something went wrong with your request."
    };
}

<section class="gs-page-intro text-center">
    <h1>@Model</h1>
    <p>@message</p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to base</a>
    <a asp-controller="Planet" asp-action="Index" class="btn btn-secondary">Galaxy map</a>
</section>
