@model List<GalacticSlicer.ViewModels.PlanetManageViewModel>
 
@{
    ViewData["Title"] = "Manage Planets";
}
 
<section class="gs-page-intro">
    <h1>@ViewData["Title"]</h1>
    <p>Add, edit and remove the planets on the Starchart.</p>
</section>
 
@* Messages from Create/Edit/Delete (TempData, shown once after the redirect) *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="gs-form-success text-center" role="status">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="gs-delete-warning text-center" role="alert">@TempData["ErrorMessage"]</div>
}
 
<div class="d-flex justify-content-center gap-3 my-4">
    <a asp-action="Create" class="gs-btn gs-btn--primary">Add Planet</a>
    <a asp-action="Index" class="gs-btn gs-btn--ghost">Back to the Starchart</a>
</div>
 
@if (!Model.Any())
{
    <p class="text-center text-muted">No planets yet. Add the first one above.</p>
}
else
{
    <section class="row justify-content-center pb-5">
        <div class="col-lg-10">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>Chapter</th>
                        <th>Name</th>
                        <th>Mission subject</th>
                        <th>Questions</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td><span class="gs-planet gs-planet--@row.Planet.CssClass" style="--gs-planet-size: 36px" aria-hidden="true"></span></td>
                            <td>@row.Planet.Order</td>
                            <td>@row.Planet.Name</td>
                            <td>@(row.Planet.Subject ?? "Mixed (every subject)")</td>
                            <td>@row.QuestionCount</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@row.Planet.PlanetId" class="gs-btn gs-btn--outline gs-btn--sm">Edit</a>
                                @if (row.CanDelete)
                                {
                                    <a asp-action="Delete" asp-route-id="@row.Planet.PlanetId" class="gs-btn gs-btn--sm gs-btn--danger">Delete</a>
                                }
                                else
                                {
                                    <span class="gs-btn gs-btn--sm gs-btn--ghost" title="The first planet and planets with questions can't be deleted">Locked</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
 