@model GalacticSlicer.Models.Character
 
@{
    ViewData["Title"] = "Add Character";
}
 
<section class="gs-auth-wrapper">
    <div class="gs-auth-card gs-auth-card--wide">
        <h1 class="gs-auth-title">Add Character</h1>
        <p class="gs-auth-subtitle">New characters show up in the Shop right away.</p>
 
        <form asp-action="Create" method="post" class="gs-form">
 
            @* name, price and description (same fields as Edit) *@
            <partial name="_CharacterForm" />
 
            <div class="gs-form-actions">
                <button type="submit" class="gs-btn gs-btn--primary">Create</button>
                <a asp-action="Manage" class="gs-btn gs-btn--ghost">Back</a>
            </div>
 
        </form>
    </div>
</section>
 
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
 