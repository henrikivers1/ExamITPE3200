@model GalacticSlicer.ViewModels.CharacterManageViewModel
@using GalacticSlicer.Helpers
 
@{
    ViewData["Title"] = "Delete Character";
}
 
<section class="gs-auth-wrapper">
    <div class="gs-auth-card gs-auth-card--wide">
        <h1 class="gs-auth-title">Delete @Model.Character.Name</h1>
        <p class="gs-auth-subtitle">This can't be undone.</p>
 
        <div class="d-flex justify-content-center mb-4">
            <span style="display: block; width: 90px">
                <partial name="_CharacterBadge" model="Model.Character" />
            </span>
        </div>
 
        <span class="gs-detail-label">Price</span>
        <p class="gs-detail-value">@Model.Character.Price Credits (@CharacterTier.Get(Model.Character.Price).Label)</p>
 
        <span class="gs-detail-label">Description</span>
        <p class="gs-detail-value">@Model.Character.Description</p>
 
        <span class="gs-detail-label">Owned by</span>
        <p class="gs-detail-value">@Model.OwnerCount player(s)</p>
 
        @* Conditional rendering: only show the Delete button when nobody owns the character *@
        @if (Model.CanDelete)
        {
            <div class="gs-delete-warning">Are you sure you want to delete this character?</div>
 
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Character.CharacterId" />
 
                <div class="gs-form-actions">
                    <button type="submit" class="gs-btn gs-btn--danger">Delete</button>
                    <a asp-action="Manage" class="gs-btn gs-btn--ghost">Cancel</a>
                </div>
            </form>
        }
        else
        {
            <div class="gs-delete-warning">
                This character can't be deleted: players have bought it, or it is the last free character.
            </div>
            <a asp-action="Manage" class="gs-btn gs-btn--ghost">Back</a>
        }
    </div>
</section>
 