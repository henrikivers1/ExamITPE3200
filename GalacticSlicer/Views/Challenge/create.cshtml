@model ExamITPE3200.Models.Challenge

@{
    ViewData["Title"] = "Create Challenge";
}

<h1>Create Challenge</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Question" class="form-label"></label>
        <textarea asp-for="Question" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="CorrectAnswer" class="form-label"></label>
        <input asp-for="CorrectAnswer" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CreditReward" class="form-label"></label>
        <input asp-for="CreditReward" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PlanetName" class="form-label"></label>
        <input asp-for="PlanetName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>