@model GalacticSlicer.Models.Challenge

@{
    ViewData["Title"] = "Create Challenge";
}

@* same themed card as Log in / Sign up, just wider *@
<section class="gs-auth-wrapper">
    <div class="gs-auth-card gs-auth-card--wide">
        <h1 class="gs-auth-title">Create Challenge</h1>
        <p class="gs-auth-subtitle">Write a question with four options and pick the correct one.</p>

        <form asp-action="Create" method="post" class="gs-form">

            @* subject, question, options and correct answer (same fields as Edit) *@
            <partial name="_ChallengeForm" />

            <div class="gs-form-actions">
                <button type="submit" class="gs-btn gs-btn--primary">Create</button>
                <a asp-action="Index" class="gs-btn gs-btn--ghost">Back</a>
            </div>

        </form>
    </div>
</section>

@* Turns on client-side validation (jQuery Validate) for the form above *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
