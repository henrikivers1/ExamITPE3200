@model GalacticSlicer.Models.Challenge

@{
    ViewData["Title"] = "Create Challenge";
}

<h1>Create Challenge</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Question" class="form-label"></label>
        <textarea asp-for="Question" class="form-control"></textarea>
        <span asp-validation-for="Question" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CorrectAnswer" class="form-label"></label>
        <input asp-for="CorrectAnswer" class="form-control" />
        <span asp-validation-for="CorrectAnswer" class="text-danger"></span>
    </div>

    
    <div class="mb-3">
        <label asp-for="OptionA" class="form-label"></label>
        <input asp-for="OptionA" class="form-control" />
        <span asp-validation-for="OptionA" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OptionB" class="form-label"></label>
        <input asp-for="OptionB" class="form-control" />
        <span asp-validation-for="OptionB" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OptionC" class="form-label"></label>
        <input asp-for="OptionC" class="form-control" />
        <span asp-validation-for="OptionC" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OptionD" class="form-label"></label>
        <input asp-for="OptionD" class="form-control" />
        <span asp-validation-for="OptionD" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="CreditReward" class="form-label"></label>
        <input asp-for="CreditReward" class="form-control" />
        <span asp-validation-for="CreditReward" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PlanetId" class="form-label"></label>
        @* The planet list comes from the database (ViewBag.Planets is set in the controller) *@
        <select asp-for="PlanetId" asp-items="ViewBag.Planets" class="form-select">
            <option value="">-- Select planet --</option>
        </select>
        <span asp-validation-for="PlanetId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>

@* Turns on client-side validation (jQuery Validate) for the form above *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
