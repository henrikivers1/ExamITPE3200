@model GalacticSlicer.Models.Challenge

@{
    ViewData["Title"] = "Challenge Details";
    var options = new[] { ("A", Model.OptionA), ("B", Model.OptionB), ("C", Model.OptionC), ("D", Model.OptionD) };
}

@* same themed card as Log in / Sign up, just wider *@
<section class="gs-auth-wrapper">
    <div class="gs-auth-card gs-auth-card--wide">
        <h1 class="gs-auth-title">Challenge Details</h1>
        <p class="gs-auth-subtitle">This is how your question looks.</p>

        <span class="gs-detail-label">Subject</span>
        <p class="gs-detail-value">@Model.Subject</p>

        <span class="gs-detail-label">Question</span>
        <p class="gs-detail-value">@Model.Question</p>

        @* the four options, with the correct one marked in green *@
        <span class="gs-detail-label">Options</span>
        <ul class="gs-option-list">
            @foreach (var (letter, text) in options)
            {
                var isCorrect = text == Model.CorrectAnswer;
                <li class="@(isCorrect ? "is-correct" : "")">
                    <span class="gs-option-letter">@letter</span>
                    <span>@text</span>
                    @if (isCorrect)
                    {
                        <span class="gs-option-correct">&#10003; Correct answer</span>
                    }
                </li>
            }
        </ul>

        <div class="gs-form-actions">
            <a asp-action="Edit" asp-route-id="@Model.ChallengeId" class="gs-btn gs-btn--primary">Edit</a>
            <a asp-action="Index" class="gs-btn gs-btn--ghost">Back</a>
        </div>
    </div>
</section>
