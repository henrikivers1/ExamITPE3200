@model GalacticSlicer.Models.Challenge

@{
    ViewData["Title"] = "Delete Challenge";
}

@* same themed card as Log in / Sign up, just wider *@
<section class="gs-auth-wrapper">
    <div class="gs-auth-card gs-auth-card--wide">
        <h1 class="gs-auth-title">Delete Challenge</h1>
        <p class="gs-auth-subtitle">This can't be undone.</p>

        @* Shown when DeleteConfirmed failed and sent the player back here *@
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="gs-delete-warning">@TempData["ErrorMessage"]</div>
        }

        <div class="gs-delete-warning">Are you sure you want to delete this challenge?</div>

        <span class="gs-detail-label">Subject</span>
        <p class="gs-detail-value">@Model.Subject</p>

        <span class="gs-detail-label">Question</span>
        <p class="gs-detail-value">@Model.Question</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="ChallengeId" />

            <div class="gs-form-actions">
                <button type="submit" class="gs-btn gs-btn--danger">Delete</button>
                <a asp-action="Index" class="gs-btn gs-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</section>
