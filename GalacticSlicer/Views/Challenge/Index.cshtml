@model IEnumerable<GalacticSlicer.Models.Challenge>

@{
    ViewData["Title"] = "Manage Challenges";
}

@{
    // true when the user has filled in at least one search field
    var isSearching = !string.IsNullOrEmpty(ViewData["SearchString"]?.ToString())
        || !string.IsNullOrEmpty(ViewData["PlanetName"]?.ToString())
        || !string.IsNullOrEmpty(ViewData["MinReward"]?.ToString());
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<section class="gs-page-intro">
    <h1>@ViewData["Title"]</h1>
    <p>Create your own challenges and find them here, or practice the subjects from the planet missions.</p>
</section>

@* Search form: method="get" because searching changes no data *@
<form asp-action="Index" method="get" class="gs-search row g-2 justify-content-center mt-4">
    <div class="col-md-4">
        <input name="searchString" value="@ViewData["SearchString"]" class="form-control" placeholder="Search title or question" />
    </div>
    <div class="col-md-3">
        <input name="planetName" value="@ViewData["PlanetName"]" class="form-control" placeholder="Planet" />
    </div>
    <div class="col-md-2">
        <input name="minReward" type="number" min="0" value="@ViewData["MinReward"]" class="form-control" placeholder="Min credits" />
    </div>
    <div class="col-md-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

@if (isSearching && !Model.Any())
{
    <p class="text-muted text-center mt-4 mb-0">No challenges match your search.</p>
}

<div class="gs-button-row gs-button-row--large justify-content-center gap-4 my-5">
    <a asp-action="Create" class="btn btn-primary">
        Create New Challenge
    </a>
    <a asp-action="Topics" class="btn gs-btn-practice">
        Practice Challenges
    </a>
</div>

@* the list only has the user's own challenges, so explain why it can be empty *@
@if (!isLoggedIn)
{
    <p class="text-muted text-center mb-5">
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Challenge">Log in</a>
        to see and manage the challenges you have made.
    </p>
}
else if (!isSearching && !Model.Any())
{
    <p class="text-muted text-center mb-5">You haven't made any challenges yet. Create your first one above!</p>
}

@* the user's own challenges in a narrower centered column so cards don't stretch edge to edge *@
<section class="row justify-content-center pb-5">
    <div class="col-lg-9">
        @foreach (var challenge in Model)
        {
            @* one challenge: title, planet and reward, then the actions *@
            <article class="challenge-card">
                <h2 class="challenge-card-title">@challenge.Title</h2>

                <div class="challenge-card-meta">
                    <span class="challenge-tag">@challenge.Planet?.Name</span>
                    <span class="challenge-reward">
                        <span aria-hidden="true">&#9679;</span> @challenge.CreditReward Credits
                    </span>
                </div>

                <div class="challenge-card-actions">
                    <a asp-action="Details" asp-route-id="@challenge.ChallengeId"
                       class="gs-btn gs-btn--outline gs-btn--sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@challenge.ChallengeId"
                       class="gs-btn gs-btn--outline gs-btn--sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@challenge.ChallengeId"
                       class="gs-btn gs-btn--sm challenge-btn-delete">Delete</a>
                </div>
            </article>
        }
    </div>
</section>
