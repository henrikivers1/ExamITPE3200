@model IEnumerable<ExamITPE3200.Models.Challenge>

@{
    ViewData["Title"] = "Challenges";
}

<h1>Challenges</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New Challenge
    </a>
</p>

@foreach (var challenge in Model)
{
    <div class="card mb-3">
        <div class="card-body">

            <h4>@challenge.Title</h4>

            <p>
                <strong>Planet:</strong>
                @challenge.PlanetName
            </p>

            <p>
                <strong>Reward:</strong>
                @challenge.CreditReward Credits
            </p>

            <a asp-action="Details"
               asp-route-id="@challenge.ChallengeId"
               class="btn btn-info">
                Details
            </a>

            <a asp-action="Edit"
               asp-route-id="@challenge.ChallengeId"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@challenge.ChallengeId"
               class="btn btn-danger">
                Delete
            </a>

        </div>
    </div>
}