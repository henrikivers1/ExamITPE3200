@model GalacticSlicer.Models.Challenge

@{
    ViewData["Title"] = "Edit Challenge";
}

@* same themed card as Log in / Sign up, just wider *@
<section class="gs-auth-wrapper">
    <div class="gs-auth-card gs-auth-card--wide">
        <h1 class="gs-auth-title">Edit Challenge</h1>
        <p class="gs-auth-subtitle">Change the question, the options or which one is correct.</p>

        <form asp-action="Edit" method="post" class="gs-form">

            <input type="hidden" asp-for="ChallengeId" />

            @* subject, question, options and correct answer (same fields as Create) *@
            <partial name="_ChallengeForm" />

            <div class="gs-form-actions">
                <button type="submit" class="gs-btn gs-btn--primary">Save</button>
                <a asp-action="Index" class="gs-btn gs-btn--ghost">Back</a>
            </div>

        </form>
    </div>
</section>

@* Turns on client-side validation (jQuery Validate) for the form above *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
