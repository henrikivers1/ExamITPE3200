@model GalacticSlicer.ViewModels.PracticeViewModel
@{
    ViewData["Title"] = Model.Subject + " practice";
}

<section class="gs-page-intro">
    <h1>@Model.Subject</h1>
    <p>Answer each question to see if you got it right, and why. Practice as often as you like: you get new random questions every time.</p>
</section>

<section class="gs-quiz-wrapper">
    <div class="gs-quiz-card">
        <div class="gs-quiz-progress-row">
            <span id="quizProgressLabel"></span>
            <div class="gs-progress-bar gs-quiz-progress-bar">
                <div class="gs-progress-bar-fill" id="quizProgressFill" style="width: 0%;"></div>
            </div>
        </div>

        @* question text, answer buttons and explanation are filled in by renderQuestion() *@
        <div id="quizQuestionArea">
            <h2 class="gs-quiz-question" id="quizQuestionText"></h2>
            <div class="gs-quiz-options" id="quizOptions"></div>
            @* shown after answering: why the correct answer is right *@
            <p class="gs-quiz-explanation" id="quizExplanation" hidden></p>
            <button type="button" class="gs-btn gs-btn--primary gs-quiz-next" id="quizNextBtn" hidden>
                Next question
            </button>
        </div>

        <div id="quizCompleteArea" class="gs-quiz-complete" hidden>
            <h2>Practice complete!</h2>
            <p id="quizScoreText"></p>
            <div class="gs-quiz-complete-actions">
                @* reloads the page with 10 new random questions *@
                <a class="gs-btn gs-btn--primary" asp-area="" asp-controller="Challenge" asp-action="Practice"
                   asp-route-subject="@Model.Subject">Practice again</a>
                <a class="gs-btn gs-btn--outline" asp-area="" asp-controller="Challenge" asp-action="Topics">Back to challenges</a>
            </div>
        </div>
    </div>

    <div class="gs-quiz-nav">
        <a class="gs-btn gs-btn--ghost" asp-area="" asp-controller="Challenge" asp-action="Topics">&larr; Back to challenges</a>
    </div>
</section>

@section Scripts {
    <script>
        // questions from the server (questions.json), options already shuffled
        const quizQuestions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Questions,
            new System.Text.Json.JsonSerializerOptions
            {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }));

        // quiz state: which question we're on, how many are right, and whether this one is answered
        let currentIndex = 0;
        let correctCount = 0;
        let answered = false;

        // page elements the script shows, hides and fills in
        const questionText = document.getElementById("quizQuestionText");
        const optionsContainer = document.getElementById("quizOptions");
        const explanationText = document.getElementById("quizExplanation");
        const nextBtn = document.getElementById("quizNextBtn");
        const progressLabel = document.getElementById("quizProgressLabel");
        const progressFill = document.getElementById("quizProgressFill");
        const questionArea = document.getElementById("quizQuestionArea");
        const completeArea = document.getElementById("quizCompleteArea");
        const scoreText = document.getElementById("quizScoreText");

        // draws the current question, its answer buttons and the progress bar
        function renderQuestion() {
            answered = false;
            const q = quizQuestions[currentIndex];

            progressLabel.textContent = "Question " + (currentIndex + 1) + " of " + quizQuestions.length;
            progressFill.style.width = Math.round((currentIndex / quizQuestions.length) * 100) + "%";

            questionText.textContent = q.question;
            optionsContainer.innerHTML = "";
            explanationText.hidden = true;
            nextBtn.hidden = true;

            q.options.forEach(function (optionText, index) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "gs-quiz-option";
                btn.textContent = optionText;
                btn.addEventListener("click", function () {
                    selectAnswer(index);
                });
                optionsContainer.appendChild(btn);
            });
        }

        // locks the answers, marks right (green) and wrong (red), counts the score and shows the explanation
        function selectAnswer(selectedIndex) {
            if (answered) {
                return;
            }
            answered = true;

            const q = quizQuestions[currentIndex];
            const optionButtons = optionsContainer.querySelectorAll(".gs-quiz-option");

            optionButtons.forEach(function (btn, index) {
                btn.disabled = true;
                if (index === q.correctIndex) {
                    btn.classList.add("gs-quiz-option--correct");
                } else if (index === selectedIndex) {
                    btn.classList.add("gs-quiz-option--incorrect");
                }
            });

            if (selectedIndex === q.correctIndex) {
                correctCount++;
            }

            if (q.explanation) {
                explanationText.textContent = q.explanation;
                explanationText.hidden = false;
            }

            nextBtn.hidden = false;
            nextBtn.textContent = currentIndex === quizQuestions.length - 1 ? "See results" : "Next question";
        }

        // go to the next question, or show the score after the last one
        nextBtn.addEventListener("click", function () {
            currentIndex++;
            if (currentIndex >= quizQuestions.length) {
                showComplete();
            } else {
                renderQuestion();
            }
        });

        // final score screen
        function showComplete() {
            progressFill.style.width = "100%";
            progressLabel.textContent = "Question " + quizQuestions.length + " of " + quizQuestions.length;
            questionArea.hidden = true;
            completeArea.hidden = false;
            scoreText.textContent = "You got " + correctCount + " out of " + quizQuestions.length + " correct.";
        }

        renderQuestion();
    </script>
}
